{
  "compilerOptions": {
  "target": "ESNext",
  "module": "CommonJS",
  "outDir": "./dist",
  "rootDir": "./src",
  "strict": true,
  "esModuleInterop": true,
  "skipLibCheck": true,
  "forceConsistentCasingInFileNames": true,
  "baseUrl": ".",
  "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": ["src", "src/*.ts", "src/**/*.ts",],
  "exclude": ["node_modules"]
}